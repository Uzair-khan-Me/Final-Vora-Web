# Public canonical URL. Set this to the final HTTPS origin before building.
# Railway can use: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SITE_URL=https://example.com

# Executable and optional outbound routing. Never put credentials in Git.
YT_DLP_PATH=yt-dlp
YT_DLP_PROXY=
# Optional: a residential/mobile proxy used ONLY when the default request
# fails YouTube's bot-verification check. Lets the operator avoid paying
# proxy cost on every request. Format: scheme://user:pass@host:port
YT_DLP_FALLBACK_PROXY=
# Absolute path to a mounted Netscape-format cookie file (not the cookie contents).
YT_DLP_COOKIES=
# For hosts without secret file mounts (e.g. Railway): store the full
# Netscape-format cookie file contents as a SECRET variable here instead of
# YT_DLP_COOKIES. The server writes it once to a private temp file (0600,
# removed at shutdown). Never commit real cookie data.
YT_DLP_COOKIES_DATA=

# Abuse and resource controls
DOWNLOAD_MAX_DURATION=7200
DOWNLOAD_MAX_CONCURRENT=2
DOWNLOAD_JOB_TTL=600
DOWNLOAD_MAX_JOBS=300
DOWNLOAD_MAX_FILE_MB=250
EXTRACTION_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=600
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60

# Container hosts normally inject PORT automatically.
PORT=3000
